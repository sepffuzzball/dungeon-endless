# Dungeon Endless environment template.
# Copy to .env (or set in your deployment) and adjust values.

# Required PostgreSQL credentials. DATABASE_URL must use the same password when
# Docker Compose is used (host "db" in Compose, "localhost" from the host).
POSTGRES_PASSWORD=
DATABASE_URL=

# AES-256-GCM encryption key for storing LLM API keys at rest.
# Use either 64 hex characters, or a base64 string decoding to exactly 32 bytes;
# no other format is accepted. Keep it secret and stable across restarts.
APP_ENCRYPTION_KEY=

# One-time bootstrap admin (both required only when no admin exists; never reset).
# Password length must be 12..72 UTF-8 bytes. These variables are never logged
# and may be removed after the first successful bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Node environment. Compose defaults to production.
NODE_ENV=production

# Cookie transport: Secure is set automatically when NODE_ENV=production.
# For local development over plain http this stays false.
SECURE_COOKIE=true

# Base URL of the deployment (used for cookie domain logic, optional).
# PUBLIC_ORIGIN=http://localhost:3000

# LLM network policy.
# Allow plain http:// endpoint URLs (default only https).
ALLOW_INSECURE_LLM_URLS=false
# Allow localhost/private/link-local endpoint hosts (default rejected).
ALLOW_PRIVATE_LLM_URLS=false

# LLM request bounds.
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=20000
LLM_MAX_RESPONSE_BYTES=8192

# One-line console diagnostics whenever an LLM helper selects its fallback.
LLM_DIAGNOSTICS=true

# Port the adapter-node server listens on.
PORT=3000
