{
	"name": "dungeon-endless",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"ci": "npm run check && npm run lint && npm test && npm run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"bootstrap": "tsx src/lib/server/bootstrap.ts"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/node": "^22.10.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.14.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.1",
		"tsx": "^4.23.12",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.2",
		"vite": "^6.0.5",
		"vitest": "^3.0.4"
	}
}
